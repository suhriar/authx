{
  "manifest_version": 3,
  "name": "AuthX",
  "description": "Authenticate X accounts and export session cookies locally.",
  "version": "1.0.0",
  "icons": {
    "16": "public/assets/icon16.png",
    "48": "public/assets/icon48.png",
    "128": "public/assets/icon128.png"
  },
  "action": {
    "default_title": "AuthX",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/assets/icon16.png",
      "48": "public/assets/icon48.png",
      "128": "public/assets/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://*.twitter.com/*",
    "https://instagram.com/*",
    "https://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*"
      ],
      "js": [
        "totp.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
